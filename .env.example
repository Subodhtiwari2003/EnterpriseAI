APP_NAME=Enterprise AI Chat
APP_ENV=development
LOG_LEVEL=INFO
AI_PROVIDER=placeholder
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1000
